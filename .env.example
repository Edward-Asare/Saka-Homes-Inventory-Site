# Database Connection (PostgreSQL or Cloud SQL)
DATABASE_URL=

# Authentication & Security Secrets (required in production)
JWT_SECRET=
SUPABASE_JWT_SECRET=
TRUST_PROXY=

# Optional CORS allow-list (comma-separated origins). Unset = same-origin only in production.
CORS_ORIGIN=

# TLS: set to "false" to skip CA verification (Render Postgres). Hosted
# Render/Supabase/Neon URLs default to skip verification automatically.
PGSSL_REJECT_UNAUTHORIZED=

# Listen port (Render injects PORT automatically)
PORT=

# Initial Bootstrap Credentials (used only when the account does not already exist)
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_GUEST_PASSWORD=

# Optional Supabase Integration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Gemini API Key
GEMINI_API_KEY=
