# Database Connection (PostgreSQL or Cloud SQL)
DATABASE_URL=

# Authentication & Security Secrets (required in production; JWT_SECRET must be 32+ characters)
JWT_SECRET=
SUPABASE_JWT_SECRET=
TRUST_PROXY=
CORS_ORIGIN=
# Leave unset in local dev. Set to false only if the database uses a private CA that Node cannot verify.
# In production, certificates are verified unless this is explicitly false.
PGSSL_REJECT_UNAUTHORIZED=

# Initial Bootstrap Credentials
# INITIAL_ADMIN_PASSWORD is used only to create the first admin (min 12 characters). Existing accounts are never overwritten.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_GUEST_PASSWORD=

# Optional Supabase Integration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini API Key
GEMINI_API_KEY=
