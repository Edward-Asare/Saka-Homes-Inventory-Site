rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() { 
      return request.auth != null; 
    }
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { 
      return request.resource.data; 
    }
    function existing() { 
      return resource.data; 
    }

    // Phase 4: Drafting "Fortress" Rules
    
    // Inventory Item Validation
    function isValidInventoryItem(data) {
      return data.keys().hasAll(['itemCode', 'itemName', 'category', 'unitOfMeasure', 'unitCost', 'status', 'createdBy'])
        && data.itemCode is string && data.itemCode.size() <= 64
        && data.itemName is string && data.itemName.size() <= 256
        && data.category is string && data.category.size() <= 128
        && data.unitOfMeasure is string && data.unitOfMeasure.size() <= 32
        && data.unitCost is number && data.unitCost >= 0
        && data.status in ['IN STOCK', 'LOW STOCK', 'OUT OF STOCK']
        && data.createdBy == request.auth.uid;
    }

    match /inventory/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(itemId) && isValidInventoryItem(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isSignedIn(); // Allow updating stock levels and status upon movement or edits
      allow delete: if isSignedIn() && existing().createdBy == request.auth.uid;
    }

    // Purchase Order Validation
    function isValidPO(data) {
      return data.keys().hasAll(['poNumber', 'itemCode', 'itemName', 'supplier', 'qtyOrdered', 'unitCost', 'totalCost', 'status', 'orderDate', 'createdBy'])
        && data.poNumber is string && data.poNumber.size() <= 64
        && data.qtyOrdered is number && data.qtyOrdered > 0
        && data.unitCost is number && data.unitCost >= 0
        && data.status in ['PENDING', 'COMPLETED', 'CANCELLED']
        && data.createdBy == request.auth.uid;
    }

    match /purchaseOrders/{poId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(poId) && isValidPO(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && (existing().createdBy == request.auth.uid);
      allow delete: if isSignedIn() && existing().createdBy == request.auth.uid;
    }

    // Category Validation
    function isValidCategory(data) {
      return data.keys().hasAll(['categoryName', 'createdBy'])
        && data.categoryName is string && data.categoryName.size() <= 128
        && data.createdBy == request.auth.uid;
    }

    match /categories/{catId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(catId) && isValidCategory(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isSignedIn(); // Allow updates for item count syncing
      allow delete: if isSignedIn() && (existing().createdBy == request.auth.uid || existing().itemCount == 0);
    }

    // Stock Movement Validation
    function isValidStockMovement(data) {
      return data.keys().hasAll(['movementCode', 'movementType', 'itemId', 'itemCode', 'quantity', 'recipient', 'issuedBy', 'createdBy'])
        && data.movementCode is string && data.movementCode.size() <= 64
        && data.movementType in ['ISSUED_OUT', 'RESTOCKED', 'ADJUSTMENT']
        && data.quantity is number && data.quantity > 0
        && data.createdBy == request.auth.uid;
    }

    match /stockMovements/{movementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(movementId) && isValidStockMovement(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
