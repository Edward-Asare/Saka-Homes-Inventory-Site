{
  "entities": {
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "An item in the Saka Homes inventory",
      "type": "object",
      "properties": {
        "itemCode": { "type": "string" },
        "itemName": { "type": "string" },
        "category": { "type": "string" },
        "unitOfMeasure": { "type": "string" },
        "minStockLevel": { "type": "number" },
        "maxStockLevel": { "type": "number" },
        "reorderQty": { "type": "number" },
        "unitCost": { "type": "number" },
        "totalValue": { "type": "number" },
        "status": { "type": "string", "enum": ["IN STOCK", "LOW STOCK", "OUT OF STOCK"] },
        "supplier": { "type": "string" },
        "lastRestocked": { "type": "string", "format": "date" },
        "nextReviewDate": { "type": "string", "format": "date" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemCode", "itemName", "category", "unitOfMeasure", "unitCost", "status", "createdBy"]
    },
    "PurchaseOrder": {
      "title": "Purchase Order",
      "description": "A purchase order for inventory restocking",
      "type": "object",
      "properties": {
        "poNumber": { "type": "string" },
        "itemCode": { "type": "string" },
        "itemName": { "type": "string" },
        "supplier": { "type": "string" },
        "qtyOrdered": { "type": "number" },
        "unitCost": { "type": "number" },
        "totalCost": { "type": "number" },
        "orderDate": { "type": "string", "format": "date" },
        "expectedDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["PENDING", "COMPLETED", "CANCELLED"] },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["poNumber", "itemCode", "supplier", "qtyOrdered", "unitCost", "status", "orderDate", "createdBy"]
    },
    "Category": {
      "title": "Category",
      "description": "Inventory category grouping",
      "type": "object",
      "properties": {
        "categoryName": { "type": "string" },
        "description": { "type": "string" },
        "primarySupplier": { "type": "string" },
        "reviewFrequency": { "type": "string" },
        "itemCount": { "type": "number" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["categoryName", "createdBy"]
    },
    "StockMovement": {
      "title": "Stock Movement",
      "description": "A record of items issued out, restocked, or adjusted",
      "type": "object",
      "properties": {
        "movementCode": { "type": "string" },
        "movementType": { "type": "string", "enum": ["ISSUED_OUT", "RESTOCKED", "ADJUSTMENT"] },
        "itemId": { "type": "string" },
        "itemCode": { "type": "string" },
        "itemName": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "unitOfMeasure": { "type": "string" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "recipient": { "type": "string" },
        "issuedBy": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["movementCode", "movementType", "itemId", "itemCode", "quantity", "recipient", "issuedBy", "createdBy"]
    }
  },
  "firestore": {
    "/inventory": { "schema": "InventoryItem", "description": "Collection of inventory items" },
    "/purchaseOrders": { "schema": "PurchaseOrder", "description": "Collection of purchase orders" },
    "/categories": { "schema": "Category", "description": "Collection of inventory categories" },
    "/stockMovements": { "schema": "StockMovement", "description": "Collection of stock movements and issued items" }
  }
}
